@startuml
!include style.puml

skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

    Class "<<interface>>\nStorage" as Storage
    Class StorageManager

    package "UserPrefs Storage" #F4F6F6 {
        Class JsonUserPrefsStorage
    }

    package "ClientBook Storage" #F4F6F6 {
        Class JsonClientBookStorage
        Class JsonSerializableClientBook
        Class JsonAdaptedPerson
        Class JsonAdaptedProject
        Class JsonAdaptedClientProject {
            clientName : String
            projectName : String
            role : String
        }
        Class JsonAdaptedTag
    }
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage

StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonClientBookStorage

JsonClientBookStorage ..> JsonSerializableClientBook

JsonSerializableClientBook --> "*" JsonAdaptedPerson
JsonSerializableClientBook --> "*" JsonAdaptedProject
JsonSerializableClientBook --> "*" JsonAdaptedClientProject

JsonAdaptedPerson --> "*" JsonAdaptedTag

@enduml