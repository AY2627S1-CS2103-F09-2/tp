@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyClientBook" as ReadOnlyClientBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class ClientBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class Address
Class Company
Class Email
Class Name
Class Note
Class Phone
Class "<<enumeration>>\nStatus" as Status
Class Tag

Class UniqueProjectList
Class Project
Class UniqueClientProjectList
Class ClientProject

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

ClientBook .up.|> ReadOnlyClientBook

ModelManager .up.|> Model
Model .left.> ReadOnlyUserPrefs
Model .right.> ReadOnlyClientBook
ModelManager -right-> "1" ClientBook
ModelManager -left-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

ClientBook *--> "1" UniquePersonList
ClientBook *--> "1" UniqueClientProjectList
ClientBook *--> "1" UniqueProjectList
UniquePersonList -[hidden]right-> UniqueClientProjectList
UniqueClientProjectList -[hidden]right-> UniqueProjectList

UniquePersonList --> "~* all" Person
UniqueClientProjectList --> "~* all" ClientProject
UniqueProjectList --> "~* all" Project
Person "*" -right- "*" Project
(Person, Project) .. ClientProject

Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person *--> Company
Person --> Status
Person *--> Note
Person *--> "*" Tag

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> Address
Address -[hidden]right-> Company
Company -[hidden]right-> Status
Status -[hidden]right-> Note

ModelManager --> "~* filtered" Person
@enduml
