<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="project-sidebar" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="10" right="8" bottom="10" left="8" />
  </padding>
  <Button fx:id="contactsButton" maxWidth="Infinity" onAction="#handleContactsSelected"
          styleClass="sidebar-button" text="Contacts" />
  <Button fx:id="projectsButton" maxWidth="Infinity" onAction="#handleProjectsSelected"
          styleClass="sidebar-button" text="Projects" />
  <VBox fx:id="projectList" spacing="2" styleClass="sidebar-project-list">
    <padding>
      <Insets top="0" right="0" bottom="0" left="12" />
    </padding>
  </VBox>
</VBox>
